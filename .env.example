# Guía de entrega para producción: docs/integracion-produccion.md
# Este archivo se incluye en el commit; configura los valores reales en el despliegue.
# Supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=tu-clave-anonima

# URL del sitio: local para desarrollo, HTTPS del despliegue en produccion.
VITE_SERVER_URL=
# URL HTTPS de confirmacion para sandbox local; se ignora en produccion.
SERVER_URL=

# Titulo de la app (opcional)
VITE_APP_TITLE=Flores Amarillas

# Solo en el servidor. Nunca uses el prefijo VITE_ para estas claves.
SUPABASE_SERVICE_ROLE_KEY=
# Cambiar a production al desplegar.
FLOW_MODE=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=

# WhatsApp de compras por codigo (solo digitos, con codigo de pais)
