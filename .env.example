# Supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=tu-clave-anonima

# Numero institucional de ventas de DSC PUCP.
# Formato internacional, sin + ni espacios. Ejemplo: 51987654321
VITE_WHATSAPP_PHONE=

# URL publica del sitio. En local puedes dejar http://localhost:3000
VITE_SERVER_URL=

# Titulo de la app (opcional)
VITE_APP_TITLE=Flores Amarillas

# Clave de YouTube Data API v3 para buscar canciones en el formulario (opcional).
# Sin ella, el formulario pide pegar el link de YouTube. En produccion:
# wrangler secret put YOUTUBE_API_KEY
YOUTUBE_API_KEY=

# Secreto del endpoint /api/activate. Generalo con: openssl rand -hex 32
API_SECRET=
